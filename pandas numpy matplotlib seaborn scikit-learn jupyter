import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load logistics dataset
df = pd.read_csv("data/logistics_data.csv")

# Display basic information
print("First five records:")
print(df.head())

print("\nDataset information:")
print(df.info())

# Check missing values
print("\nMissing values:")
print(df.isnull().sum())

# Check duplicate records
print("\nDuplicate records:", df.duplicated().sum())

# KPI 1: On-Time Delivery Rate
total_shipments = len(df)
on_time_shipments = (df["Delivery_Status"] == "On-Time").sum()

on_time_rate = (on_time_shipments / total_shipments) * 100

# KPI 2: Average Transit Time
average_transit_time = df["Actual_Delivery_Hours"].mean()

# KPI 3: Average Shipping Cost
average_shipping_cost = df["Shipping_Cost"].mean()

# KPI 4: Average Delay
average_delay = df["Delay_Hours"].mean()

print("\n--- Logistics KPIs ---")
print(f"On-Time Delivery Rate: {on_time_rate:.2f}%")
print(f"Average Transit Time: {average_transit_time:.2f} hours")
print(f"Average Shipping Cost: {average_shipping_cost:.2f}")
print(f"Average Delay: {average_delay:.2f} hours")

# Correlation analysis
numeric_columns = [
    "Distance_km",
    "Shipment_Weight_kg",
    "Actual_Delivery_Hours",
    "Shipping_Cost",
    "Delay_Hours"
]

correlation = df[numeric_columns].corr()

print("\nCorrelation Matrix:")
print(correlation)

# Visualization
plt.figure(figsize=(8, 5))

sns.scatterplot(
    data=df,
    x="Distance_km",
    y="Shipping_Cost"
)

plt.title("Distance vs Shipping Cost")
plt.xlabel("Distance (km)")
plt.ylabel("Shipping Cost")

plt.tight_layout()
plt.show()
